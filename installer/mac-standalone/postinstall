  chown root:_lightemdb "$STATE/run/database-init.sql"
  chmod 640 "$STATE/run/database-init.sql"
fi
[ -f "$ROOT_SECRET" ] || die 'Private administrator credentials are missing; the database was preserved'
write_configuration
register_service database
DB_REGISTERED=1
for attempt in $(seq 1 40); do /usr/bin/nc -z 127.0.0.1 3307 && break; sleep 1; done
run_php "$PAYLOAD/database-admin.php" --data-dir "$DATA" --credentials "$ROOT_SECRET" --database-port 3307
rm -f "$STATE/run/database-init.sql"
write_configuration

