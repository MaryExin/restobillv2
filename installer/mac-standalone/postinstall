  run_php "$PAYLOAD/migrate.php" --source-root "$LEGACY/htdocs" --root "$WEBROOT" --payload "$PAYLOAD" --credentials "$CREDENTIALS" --bootstrap-password-file "$ROOT_SECRET" --database-port 3307 --data-dir "$DATA" --mysqldump-path "$RUNTIME/bin/mysqldump" --mysql-path "$RUNTIME/bin/mysql" --runtime-group _lightemhttp --backup-dir "$STATE/database-backups"
