#!/bin/bash
set -Eeuo pipefail
umask 077
export PHP_INI_SCAN_DIR=''
unset PHPRC DYLD_LIBRARY_PATH DYLD_INSERT_LIBRARIES

STATE='/Library/Application Support/LightemStandalone'
PAYLOAD="$STATE/setup"
WEBROOT="$STATE/backend"
PHPMYADMIN="$STATE/phpmyadmin"
DATA="$STATE/data"
ROOT_SECRET="$STATE/secrets/database-root.txt"
RUNTIME_BASE='/Library/Lightem/runtime'
APP='/Applications/Lightem Pos.app'
LEGACY='/Applications/XAMPP/xamppfiles'
LOG='/var/log/lightem-standalone-setup.log'
RUN_ID="$(date -u +%Y%m%d%H%M%S)-$$"
BACKUP="$STATE/backups/$RUN_ID"
STEP='Preparing standalone setup'
MODE=fresh
# Compiled into each package: the normal installer never inspects XAMPP.
# The setup app selects the separate import package only after an explicit choice.
COPY_XAMPP_REQUESTED=0
CHANGED=0
PROVISIONED=0
APP_CHANGED=0
HTTP_PORT=8080
EXISTING_HTTP_PORT=8080
ACTIVE_HTTP_PORT=8080
DB_REGISTERED=0
HTTP_REGISTERED=0
OLD_RUNTIME=''
RUNTIME=''
exec 3>&2

say() { printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$*"; }
step() { STEP="$1"; say "$STEP"; }
die() { printf 'Lightem standalone setup failed during: %s. %s. Log: %s\n' "$STEP" "$*" "$LOG" >&3; exit 1; }
safe_path() {
  local current="$1"
  while [ "$current" != / ]; do
    [ ! -L "$current" ] || die 'An installation path is a symbolic link; no redirected files will be changed'
    current="${current%/*}"
    [ -n "$current" ] || current=/
  done
}
# BEGIN STANDALONE PROCESS CHECKS
port_pids() {
  local output status=0
  # Bash 3.2 inherits ERR inside $(...) despite the outer status handler.
  # Guard the command inside the substitution so an unused port remains status 1.
  output=$(if /usr/sbin/lsof -nP -t -iTCP:"$1" -sTCP:LISTEN 2>/dev/null; then exit 0; else exit $?; fi) || status=$?
  [ "$status" -le 1 ] || die "Cannot inspect local service ports (lsof exit $status)"
  printf '%s' "$output"
}
port_belongs_to() {
  local port="$1" prefix="$2" pid executable listeners
  listeners=$(port_pids "$port") || return 1
  for pid in $listeners; do
    # Read every lsof record: head -1 closes the pipe early and can turn a
    # healthy process inspection into SIGPIPE under the installer's pipefail.
    executable=$(if /usr/sbin/lsof -a -p "$pid" -d txt -Fn 2>/dev/null | /usr/bin/awk '/^n/ && !found {print substr($0,2);found=1}'; then exit 0; else exit $?; fi) || return 1
    case "$executable" in "$prefix"/*) ;; *) return 1 ;; esac
  done
}
wait_port_closed() {
  local attempt listeners
  for attempt in $(seq 1 30); do
    listeners=$(port_pids "$1") || return 1
    [ -n "$listeners" ] || return 0
    sleep 1
  done
  return 1
}
runtime_processes_present() {
  local processes
  processes=$(/bin/ps -axo command=) || return 2
  printf '%s\n' "$processes" | /usr/bin/awk -v prefix="$RUNTIME_BASE/" -v name="/bin/$1" 'index($1,prefix)==1 && substr($1,length($1)-length(name)+1)==name {found=1} END {exit !found}'
}
stop_service() {
  local executable attempt status listeners
  if [ "$1" = http ]; then executable=httpd; else executable=mysqld; fi
  /bin/launchctl bootout "system/com.lightem.standalone.$1" >/dev/null 2>&1 || true
  for attempt in $(seq 1 30); do
    listeners=$(port_pids "$2") || return 1
    status=0; runtime_processes_present "$executable" || status=$?
    [ "$status" -le 1 ] || return 1
    # After the owned Apache workers exit, XAMPP may take the old port 80.
    # Never wait for or stop that unrelated listener during update/rollback.
    if [ "$status" -eq 1 ] && { [ "$1" = http ] || [ -z "$listeners" ]; }; then return 0; fi
    sleep 1
  done
  return 1
}
# END STANDALONE PROCESS CHECKS
# BEGIN STANDALONE SERVICE OWNERSHIP
validate_service_ownership() {
  local kind="$1" plist label loaded status=0 executable loaded_program metadata
  label="com.lightem.standalone.$kind"
  plist="/Library/LaunchDaemons/$label.plist"
  safe_path "$plist"
  # A missing service is expected on first install. Preserve launchctl's status
  # before the inherited ERR trap can turn its 113 into a setup failure.
  loaded=$(if /bin/launchctl print "system/$label" 2>/dev/null; then exit 0; else exit $?; fi) || status=$?
  [ "$status" -eq 0 ] || [ "$status" -eq 113 ] || die "Cannot inspect the registered Lightem service $label (launchctl exit $status)"
  if [ ! -e "$plist" ]; then
    [ "$status" -eq 113 ] || die 'A loaded Lightem service has no matching owned configuration'
    return
  fi
  [ -f "$plist" ] && [ ! -L "$plist" ] || die 'The service configuration is not a regular file'
  metadata=$(/usr/bin/stat -f '%u:%Lp' "$plist") || die 'Cannot inspect service configuration ownership'
  [ "${metadata%%:*}" = 0 ] || die 'The service configuration is not owned by root'
  [[ "${metadata#*:}" =~ ^[0-7]{3,4}$ ]] || die 'The service configuration permissions are invalid'
  [ $((8#${metadata#*:} & 0022)) -eq 0 ] || die 'The service configuration is writable by another user'
  executable=$(/usr/bin/plutil -convert json -o - "$plist" | run_php -r '
    $p=json_decode(stream_get_contents(STDIN),true,512,JSON_THROW_ON_ERROR);
    $kind=$argv[1];$base=$argv[2];$state=$argv[3];$label="com.lightem.standalone.".$kind;
    $args=$p["ProgramArguments"]??null;$exe=is_array($args)?($args[0]??""):"";
    $name=$kind==="http"?"httpd":"mysqld";$user=$kind==="http"?"root":"_lightemdb";
    if(($p["Label"]??"")!==$label || ($p["UserName"]??"")!==$user || isset($p["Program"]) || !is_string($exe) || !preg_match("~^".preg_quote($base,"~")."/[1-9][0-9]{0,19}/bin/".$name."$~D",$exe))exit(1);
    $expected=$kind==="http"?[$exe,"-f",$state."/config/httpd.conf","-DFOREGROUND"]:[$exe,"--defaults-file=".$state."/config/database.cnf"];
    if($args!==$expected)exit(1);echo $exe;
  ' "$kind" "$RUNTIME_BASE" "$STATE") || die 'The service belongs to another installation or uses unexpected settings'
  if [ "$status" -eq 0 ]; then
    loaded_program=$(printf '%s\n' "$loaded" | /usr/bin/sed -n 's/^[[:space:]]*program = //p')
    [ "$loaded_program" = "$executable" ] || die 'The loaded service executable differs from its owned configuration'
  fi
}
# END STANDALONE SERVICE OWNERSHIP

run_php() { "$RUNTIME/bin/php" -n "$@"; }
# BEGIN STANDALONE CLASSIFICATION
installation_phase() {
  run_php -r '
    $path=$argv[1];
    if (!file_exists($path)) { echo "none"; exit; }
    if (is_link($path) || fileowner($path)!==0 || (fileperms($path)&0077)!==0) exit(1);
    $s=json_decode(file_get_contents($path),true,512,JSON_THROW_ON_ERROR);
    $m=json_decode(file_get_contents($argv[2]),true,512,JSON_THROW_ON_ERROR);
    if (($s["formatVersion"]??0)!==1 || ($s["runtimeKind"]??"")!=="standalone" || ($s["dataRoot"]??"")!==$argv[3] || ($s["runtimeSha256"]??"")!==$m["runtimeSha256"] || !in_array($s["sourceKind"]??"",["fresh","legacy"],true) || !in_array($s["status"]??"",["initializing","ready"],true)) exit(1);
    if (array_key_exists("httpPort",$s) && !in_array($s["httpPort"],[80,8080],true)) exit(1);
    echo $s["status"]==="ready" ? "ready" : "pending-".$s["sourceKind"];
  ' "$STATE/standalone-runtime.json" "$PAYLOAD/manifest.json" "$DATA"
}
record_phase() {
  run_php -r '
    $m=json_decode(file_get_contents($argv[2]),true,512,JSON_THROW_ON_ERROR);
    $v=["formatVersion"=>1,"runtimeKind"=>"standalone","status"=>$argv[4],"sourceKind"=>$argv[5],"dataRoot"=>$argv[3],"runtimeSha256"=>$m["runtimeSha256"],"httpPort"=>(int)$argv[6]];
    $f=$argv[1].".tmp";if(is_link($f))exit(1);
    if(file_put_contents($f,json_encode($v,JSON_THROW_ON_ERROR)."\n")===false)exit(1);
    if(!chmod($f,0600)||!rename($f,$argv[1]))exit(1);
  ' "$STATE/standalone-runtime.json" "$PAYLOAD/manifest.json" "$DATA" "$1" "$SOURCE_KIND" "$HTTP_PORT"
}
classify_installation() {
  PHASE=$(installation_phase) || die 'The protected standalone state is invalid or requires a tested runtime upgrade'
  SOURCE_KIND=fresh
  if [ "$PHASE" = pending-legacy ]; then
    [ "$COPY_XAMPP_REQUESTED" = 1 ] || die 'An unfinished XAMPP import was preserved. Select Copy data from XAMPP in Lightem Setup to resume it'
    [ -f "$LEGACY/htdocs/api/bootstrap.php" ] && [ -f "$LEGACY/htdocs/.env" ] || die 'The original backend is required to verify the interrupted migration'
    MODE=migrate; SOURCE_KIND=legacy
  elif [ -f "$WEBROOT/.lightem-managed-install.json" ]; then
    [ "$PHASE" != none ] || die 'The private backend has no matching protected installation state'
    MODE=update
  elif [ "$PHASE" = ready ]; then
    die 'The installed backend marker is missing; preserved data requires recovery'
  elif [ "$PHASE" = pending-fresh ]; then
    MODE=fresh
  elif [ "$COPY_XAMPP_REQUESTED" = 1 ]; then
    [ -f "$LEGACY/htdocs/api/bootstrap.php" ] && [ -f "$LEGACY/htdocs/.env" ] || die 'Copy data from XAMPP was selected, but its Lightem backend or settings are missing. Uncheck this option for a new standalone store'
    [ -z "$(ls -A "$WEBROOT")" ] && [ -z "$(ls -A "$DATA")" ] || die 'Unrecognized private files were preserved; review is required before migration'
    MODE=migrate; SOURCE_KIND=legacy
  elif [ -n "$(ls -A "$WEBROOT")" ] || [ -n "$(ls -A "$DATA")" ]; then
    die 'The private installation contains unrelated files; recovery is required before replacement'
  fi
}
# END STANDALONE CLASSIFICATION
# BEGIN STANDALONE HTTP TRANSITION
existing_http_port() {
  if [ "$PHASE" = none ]; then printf '%s' "$HTTP_PORT"; return; fi
  # Classification has already validated this protected ownership record.
  # Records written before separate-port support did not contain httpPort.
  run_php -r '
    $s=json_decode(file_get_contents($argv[1]),true,512,JSON_THROW_ON_ERROR);
    $port=$s["httpPort"]??80;
    if (!in_array($port,[80,8080],true)) exit(1);
    echo $port;
  ' "$STATE/standalone-runtime.json"
}
check_http_destination() {
  # Port 80 is deliberately outside this check: it may belong to XAMPP.
  port_belongs_to "$HTTP_PORT" "$RUNTIME_BASE" || die "Standalone web port $HTTP_PORT belongs to another application"
}
stop_private_http() {
  stop_service http "$ACTIVE_HTTP_PORT" || die 'The private web server did not stop'
}
# END STANDALONE HTTP TRANSITION
# BEGIN STANDALONE LEGACY COPY CHECKS
check_legacy_source() {
  local listeners
  listeners=$(port_pids 3306) || die 'Cannot inspect the original database port'
  [ -n "$listeners" ] || die 'Start MySQL in XAMPP and pause sales before copying its store. Setup does not start or change XAMPP services'
  port_belongs_to 3306 "$LEGACY" || die 'The original database port belongs to another server'
  # Validate settings before any connection. Bundled PHP works independently
  # of the XAMPP PHP version, extensions and socket configuration.
  run_php -r '
    require $argv[1];
    try {
      [, $config]=lightemSettings(lightemRoot($argv[2]));
      if (!in_array((string)$config["host"],["localhost","127.0.0.1"],true) || lightemDatabasePort($config["port"]??3306)!==3306) {
        throw new LightemSetupException("The copy source must use local XAMPP MySQL on port 3306; no remote or custom-port database was contacted.");
      }
      if ($argv[4]==="verify") {
        $result=lightemVerifyInstallation(lightemRoot($argv[2]),lightemRoot($argv[3]),true,false,static function(array $settings,?string $database=null):PDO {
          $settings["host"]="127.0.0.1";$settings["port"]=3306;
          return lightemConnect($settings,$database);
        });
        echo json_encode($result,JSON_THROW_ON_ERROR)."\n";
      }
    } catch (Throwable $error) { lightemFail($error); }
  ' "$PAYLOAD/verify.php" "$LEGACY/htdocs" "$PAYLOAD" "${1:-settings}"
}
# END STANDALONE LEGACY COPY CHECKS
write_state() {
  run_php -r '$m=json_decode(file_get_contents($argv[1]),true,512,JSON_THROW_ON_ERROR);$v=["installerId"=>"com.lenard.restobill.setup","formatVersion"=>1,"runtimeKind"=>"standalone","version"=>$m["version"],"buildId"=>$m["buildId"],"runtimeRoot"=>$argv[3],"httpPort"=>(int)$argv[4]];file_put_contents($argv[2].".tmp",json_encode($v,JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n");chmod($argv[2].".tmp",0644);rename($argv[2].".tmp",$argv[2]);' "$PAYLOAD/manifest.json" "$STATE/installation.json" "$RUNTIME" "$HTTP_PORT"
}
cleanup() {
  local status=$?
  local listeners
  trap - EXIT ERR
  set +e +u
  if [ "$status" -ne 0 ]; then
    say "Setup failed during $STEP. Recovery files: $BACKUP"
    if [ "$CHANGED" -eq 1 ]; then
      if stop_service http "$ACTIVE_HTTP_PORT" && stop_service database 3307; then
        if [ "$MODE" = update ]; then
          for part in backend config installation.json standalone-runtime.json; do
            if [ -e "$BACKUP/$part" ]; then rm -rf "$STATE/$part"; /usr/bin/ditto "$BACKUP/$part" "$STATE/$part"; fi
          done
          rm -rf "$PHPMYADMIN"
          [ ! -d "$BACKUP/phpmyadmin" ] || /usr/bin/ditto "$BACKUP/phpmyadmin" "$PHPMYADMIN"
          for service in http database; do
            if [ -f "$BACKUP/com.lightem.standalone.$service.plist" ]; then
              /usr/bin/ditto "$BACKUP/com.lightem.standalone.$service.plist" "/Library/LaunchDaemons/com.lightem.standalone.$service.plist"
              if [ "$service" = http ] && ! port_belongs_to "$EXISTING_HTTP_PORT" "$RUNTIME_BASE"; then
                say "The previous HTTP configuration was restored, but port $EXISTING_HTTP_PORT is now occupied. Its service was left stopped; the other application was not changed."
                continue
              fi
              /bin/launchctl bootstrap system "/Library/LaunchDaemons/com.lightem.standalone.$service.plist" || true
            fi
          done
        elif [ "$PROVISIONED" -eq 1 ]; then
          say 'Verified private database and configuration retained for a safe retry.'
        fi
        if [ "$APP_CHANGED" -eq 1 ]; then
          rm -rf "$APP"
          [ ! -d "$BACKUP/Lightem Pos.app" ] || /usr/bin/ditto "$BACKUP/Lightem Pos.app" "$APP"
        fi
      else
        say 'Automatic file restoration stopped because a service is still running. Recovery copies were preserved.'
      fi
    fi
    printf 'Standalone installation did not complete. Step: %s. Log: %s\n' "$STEP" "$LOG" >&3
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'die "A required operation failed at line $LINENO (exit $?); see the protected setup log"' ERR

# BEGIN STANDALONE ACCOUNTS
ensure_service_account() {
  local name="$1" candidate user_id group_id users groups user_exists=0 group_exists=0 properties='' field expected actual missing=''
  users=$(/usr/bin/dscl . -list /Users UniqueID) || die 'Cannot inspect local user identifiers'
  groups=$(/usr/bin/dscl . -list /Groups PrimaryGroupID) || die 'Cannot inspect local group identifiers'
  safe_path "$STATE/accounts/$name"
  if [ -f "$STATE/accounts/$name" ]; then
    IFS=: read -r candidate group_id < "$STATE/accounts/$name"
    [[ "$candidate" =~ ^[34][0-9][0-9]$ ]] && [ "$candidate" = "$group_id" ] || die 'The managed account record is invalid'
  else
    if printf '%s\n' "$users" | /usr/bin/awk -v n="$name" '$1==n {found=1} END {exit !found}' || printf '%s\n' "$groups" | /usr/bin/awk -v n="$name" '$1==n {found=1} END {exit !found}'; then die 'A service account name is already used by another installation'; fi
    for candidate in $(seq 300 499); do
      if ! printf '%s\n' "$users" | /usr/bin/awk '{print $2}' | /usr/bin/grep -qx "$candidate" && ! printf '%s\n' "$groups" | /usr/bin/awk '{print $2}' | /usr/bin/grep -qx "$candidate"; then break; fi
    done
    [ "$candidate" -lt 499 ] || die 'No service account identifier is available'
    printf '%s:%s\n' "$candidate" "$candidate" > "$STATE/accounts/$name"
    chmod 600 "$STATE/accounts/$name"
  fi
  user_id=$(printf '%s\n' "$users" | /usr/bin/awk -v n="$name" '$1==n {print $2}')
  group_id=$(printf '%s\n' "$groups" | /usr/bin/awk -v n="$name" '$1==n {print $2}')
  [ -z "$user_id" ] || [ "$user_id" = "$candidate" ] || die 'A managed service account identifier was changed'
  [ -z "$group_id" ] || [ "$group_id" = "$candidate" ] || die 'A managed service group identifier was changed'
  if printf '%s\n' "$users" | /usr/bin/awk -v n="$name" -v id="$candidate" '$2==id && $1!=n {found=1} END {exit !found}' || printf '%s\n' "$groups" | /usr/bin/awk -v n="$name" -v id="$candidate" '$2==id && $1!=n {found=1} END {exit !found}'; then die 'A service account identifier is used by another account'; fi
  if printf '%s\n' "$users" | /usr/bin/awk -v n="$name" '$1==n {found=1} END {exit !found}'; then user_exists=1; fi
  if printf '%s\n' "$groups" | /usr/bin/awk -v n="$name" '$1==n {found=1} END {exit !found}'; then group_exists=1; fi
  if [ "$user_exists" -eq 1 ]; then
    properties=$(/usr/bin/dscl . -read "/Users/$name" UniqueID PrimaryGroupID UserShell NFSHomeDirectory IsHidden) || die 'Cannot inspect managed service account properties'
  fi
  # Inspect only non-secret properties. Existing complete accounts need no
  # directory writes, especially no Password reset during an app update.
  for field in UniqueID PrimaryGroupID UserShell NFSHomeDirectory IsHidden; do
    case "$field" in
      UniqueID|PrimaryGroupID) expected="$candidate" ;;
      UserShell) expected=/usr/bin/false ;;
      NFSHomeDirectory) expected=/var/empty ;;
      IsHidden) expected=1 ;;
    esac
    actual=$(printf '%s\n' "$properties" | /usr/bin/awk -v key="$field" '
      $1==key":" || $1=="dsAttrTypeNative:"key":" {
        if (NF!=2 || count++) invalid=1
        value=$2
      }
      END {if (invalid) exit 1; printf "%s", value}
    ') || die 'The managed service account properties are invalid'
    if [ -z "$actual" ]; then
      missing="$missing $field"
    else
      [ "$actual" = "$expected" ] || die "A managed service account property was changed: $field"
    fi
  done
  if [ "$user_exists" -eq 1 ] && [ "$group_exists" -eq 1 ] && [ -n "$group_id" ] && [ -z "$missing" ]; then return 0; fi
  # A protected account record permits resuming only missing creation steps.
  [ "$group_exists" -eq 1 ] || /usr/bin/dscl . -create "/Groups/$name"
  [ -n "$group_id" ] || /usr/bin/dscl . -create "/Groups/$name" PrimaryGroupID "$candidate"
  [ "$user_exists" -eq 1 ] || /usr/bin/dscl . -create "/Users/$name"
  for field in $missing; do
    case "$field" in
      UniqueID|PrimaryGroupID) expected="$candidate" ;;
      UserShell) expected=/usr/bin/false ;;
      NFSHomeDirectory) expected=/var/empty ;;
      IsHidden) expected=1 ;;
    esac
    /usr/bin/dscl . -create "/Users/$name" "$field" "$expected"
  done
  [ "$user_exists" -eq 1 ] || /usr/bin/dscl . -create "/Users/$name" Password '*'
}
# END STANDALONE ACCOUNTS

# BEGIN STANDALONE BOOTSTRAP
bootstrap_database() {
  # The bundled mysql_install_db has unquoted ownership commands. A relative
  # path avoids splitting "Application Support" without changing the runtime.
  (
    cd "$DATA" || exit 1
    # Installer's inherited TMPDIR is root-only. Keep both temporary-file paths
    # private to the database account; the vendor also splits forwarded options.
    TMPDIR="$STATE/run/database/tmp" "$RUNTIME/bin/mysql_install_db" --no-defaults --basedir="$RUNTIME" --datadir=. --tmpdir=../run/database/tmp --user=_lightemdb --auth-root-authentication-method=normal --skip-test-db
  )
}
# END STANDALONE BOOTSTRAP

# BEGIN STANDALONE INCOMPLETE DATABASE
recover_incomplete_bootstrap() {
  safe_path "$DATA"
  safe_path "$WEBROOT"
  [ -n "$(ls -A "$DATA")" ] || return 0
  [ ! -e "$ROOT_SECRET" ] && [ ! -L "$ROOT_SECRET" ] || return 0
  case "$PHASE:$MODE" in pending-fresh:fresh|pending-legacy:migrate) ;; *) return 0 ;; esac
  [ -z "$(ls -A "$WEBROOT")" ] || die 'Private backend files were preserved; database recovery requires review'
  # No administrator secret has been prepared and no backend has been copied.
  # Preserve only recognized bootstrap output, never an unrelated database.
  run_php -r '
    $root=$argv[1];
    foreach(new DirectoryIterator($root) as $f){
      if($f->isDot())continue;
      $name=$f->getFilename();
      if($f->isLink())exit(1);
      if($f->isDir()){
        if(!in_array($name,["mysql","performance_schema","sys"],true))exit(1);
        foreach(new RecursiveIteratorIterator(new RecursiveDirectoryIterator($f->getPathname(),FilesystemIterator::SKIP_DOTS),RecursiveIteratorIterator::SELF_FIRST) as $child){
          if($child->isLink()||(!$child->isDir()&&!$child->isFile()))exit(1);
        }
      }elseif(!$f->isFile()||!preg_match("/^(?:aria_log_control|aria_log\\.[0-9]+|ibdata[0-9]+|ib_logfile[0-9]+|ib_buffer_pool|tc\\.log|mysql_upgrade_info)$/D",$name))exit(1);
    }
  ' "$DATA" || die 'Unrecognized database files were preserved; recovery requires review'
  safe_path "$BACKUP/incomplete-database"
  [ ! -e "$BACKUP/incomplete-database" ] || die 'The database recovery destination already exists'
  mv "$DATA" "$BACKUP/incomplete-database"
  mkdir "$DATA"
  chown _lightemdb:_lightemdb "$DATA"
  chmod 700 "$DATA"
  say "Preserved interrupted database initialization in $BACKUP/incomplete-database"
}
# END STANDALONE INCOMPLETE DATABASE

# BEGIN STANDALONE CONFIGURATION
write_configuration() {
  local init_clause=''
  [ ! -f "$STATE/run/database-init.sql" ] || init_clause="init-file=\"$STATE/run/database-init.sql\""
  cat > "$STATE/config/database.cnf" <<EOF
[mysqld]
basedir="$RUNTIME"
datadir="$DATA"
tmpdir="$STATE/run/database/tmp"
port=3307
bind-address=127.0.0.1
skip-name-resolve
socket="$STATE/run/database/mysql.sock"
pid-file="$STATE/run/database/mysql.pid"
log-error="$STATE/logs/database/error.log"
plugin-dir="$RUNTIME/lib/mysql/plugin"
character-sets-dir="$RUNTIME/share/mysql/charsets"
lc-messages-dir="$RUNTIME/share/mysql"
event-scheduler=OFF
local-infile=0
symbolic-links=0
$init_clause
EOF
  cat > "$STATE/config/php.ini" <<EOF
[PHP]
date.timezone=Asia/Manila
display_errors=Off
log_errors=On
error_log="$STATE/logs/http/php-error.log"
memory_limit=256M
post_max_size=64M
upload_max_filesize=64M
upload_tmp_dir="$STATE/run/http"
session.save_path="$STATE/run/http"
expose_php=Off
allow_url_include=Off
mysqli.default_port=3307
pdo_mysql.default_socket="$STATE/run/database/mysql.sock"
curl.cainfo=/etc/ssl/cert.pem
openssl.cafile=/etc/ssl/cert.pem
EOF
  cat > "$STATE/config/httpd.conf" <<EOF
ServerRoot "$RUNTIME"
Listen ${HTTP_PORT:-8080}
ServerName localhost
PidFile "$STATE/run/http/httpd.pid"
DefaultRuntimeDir "$STATE/run/http"
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_host_module modules/mod_authz_host.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule mime_module modules/mod_mime.so
LoadModule dir_module modules/mod_dir.so
LoadModule alias_module modules/mod_alias.so
LoadModule headers_module modules/mod_headers.so
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule unixd_module modules/mod_unixd.so
LoadModule env_module modules/mod_env.so
LoadModule setenvif_module modules/mod_setenvif.so
LoadModule php_module modules/libphp.so
User _lightemhttp
Group _lightemhttp
PHPIniDir "$STATE/config"
DocumentRoot "$WEBROOT"
DirectoryIndex index.php index.html
TypesConfig /dev/null
AddType text/css .css
AddType application/javascript .js
AddType image/png .png
