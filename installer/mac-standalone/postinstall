safe_path "$RUNTIME"
mkdir -p "$RUNTIME_BASE"
chown root:wheel /Library/Lightem "$RUNTIME_BASE"
chmod 755 /Library/Lightem "$RUNTIME_BASE"
if [ ! -e "$RUNTIME" ]; then /usr/bin/ditto "$PAYLOAD/runtime" "$RUNTIME"; chown -R root:wheel "$RUNTIME"; chmod -R u+rwX,go+rX,go-w "$RUNTIME"; fi
run_php "$PAYLOAD/verify-runtime.php" --root "$RUNTIME" --platform darwin --sha256 "$(/usr/bin/plutil -extract runtimeSha256 raw -o - "$PAYLOAD/manifest.json")"
