for part in accounts secrets backups config run logs backend data database-backups; do safe_path "$STATE/$part"; mkdir -p "$STATE/$part"; done
chmod 700 "$STATE/accounts" "$STATE/secrets" "$STATE/backups"
mkdir -p "$BACKUP"
safe_path "$STATE/standalone-runtime.json"
classify_installation
EXISTING_HTTP_PORT=$(existing_http_port) || die 'The existing standalone web port is invalid; its configuration was preserved'
ACTIVE_HTTP_PORT="$EXISTING_HTTP_PORT"
if [ "$PHASE" = none ] && [ "$MODE" != update ] && [ -d "$PHPMYADMIN" ] && [ -n "$(ls -A "$PHPMYADMIN")" ]; then
  die 'An existing database browser without a standalone ownership marker was preserved; review is required before replacement'
fi
if [ -f "$WEBROOT/.lightem-managed-install.json" ]; then
  run_php -r '$o=json_decode(file_get_contents($argv[1]),true,512,JSON_THROW_ON_ERROR);$n=json_decode(file_get_contents($argv[2]),true,512,JSON_THROW_ON_ERROR);if(($o["runtimeKind"]??"")!=="standalone" || version_compare($o["version"],$n["version"],">") || (strlen($o["buildId"])>strlen($n["buildId"])) || (strlen($o["buildId"])===strlen($n["buildId"])&&strcmp($o["buildId"],$n["buildId"])>0))exit(1);' "$WEBROOT/.lightem-managed-install.json" "$PAYLOAD/manifest.json" || die 'This backend is incompatible or newer than the installer'
  run_php -r '$o=json_decode(file_get_contents($argv[1]),true,512,JSON_THROW_ON_ERROR);$n=json_decode(file_get_contents($argv[2]),true,512,JSON_THROW_ON_ERROR);if(($o["runtimeSha256"]??"")!==$n["runtimeSha256"])exit(1);' "$WEBROOT/.lightem-managed-install.json" "$PAYLOAD/manifest.json" || die 'A tested server-runtime upgrade is required before replacing this database engine'
