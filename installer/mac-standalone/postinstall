register_service() {
  local kind="$1" executable arguments username
  if [ "$kind" = database ]; then
    executable="$RUNTIME/bin/mysqld"
    username='_lightemdb'
    arguments="<string>--defaults-file=$STATE/config/database.cnf</string>"
  else
    executable="$RUNTIME/bin/httpd"
    username=root
    arguments="<string>-f</string><string>$STATE/config/httpd.conf</string><string>-DFOREGROUND</string>"
  fi
  cat > "/Library/LaunchDaemons/com.lightem.standalone.$kind.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict><key>Label</key><string>com.lightem.standalone.$kind</string><key>UserName</key><string>$username</string><key>ProgramArguments</key><array><string>$executable</string>$arguments</array><key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>10</integer><key>EnvironmentVariables</key><dict><key>PHP_INI_SCAN_DIR</key><string></string></dict></dict></plist>
EOF
  chown root:wheel "/Library/LaunchDaemons/com.lightem.standalone.$kind.plist"
  chmod 644 "/Library/LaunchDaemons/com.lightem.standalone.$kind.plist"
  /usr/bin/plutil -lint "/Library/LaunchDaemons/com.lightem.standalone.$kind.plist"
  /bin/launchctl bootstrap system "/Library/LaunchDaemons/com.lightem.standalone.$kind.plist"
}
