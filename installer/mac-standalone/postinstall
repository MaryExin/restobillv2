for part in backend config phpmyadmin installation.json standalone-runtime.json; do [ ! -e "$STATE/$part" ] || /usr/bin/ditto "$STATE/$part" "$BACKUP/$part"; done
[ ! -d "$APP" ] || /usr/bin/ditto "$APP" "$BACKUP/Lightem Pos.app"
step 'Checking registered Lightem services'
for service in http database; do validate_service_ownership "$service"; done
for service in http database; do [ ! -f "/Library/LaunchDaemons/com.lightem.standalone.$service.plist" ] || /usr/bin/ditto "/Library/LaunchDaemons/com.lightem.standalone.$service.plist" "$BACKUP/com.lightem.standalone.$service.plist"; done

