# BEGIN STANDALONE DESKTOP ENDPOINT
set_desktop_local_endpoint() {
  local file="$APP/Contents/Resources/ip.txt"
  safe_path "$file"
  run_php -r '
    $file=$argv[1];$origin="http://localhost:".$argv[2];
    $text=is_file($file)?file_get_contents($file):"WEB: \nTENANT: \n";
    if (!is_string($text)) exit(1);
    $count=preg_match_all("/^[ \\t]*LOCAL[ \\t]*:[ \\t]*([^\\r\\n]*)/im",$text,$matches,PREG_OFFSET_CAPTURE);
    if ($count>1) { fwrite(STDERR,"Multiple LOCAL entries in desktop server configuration; review the preserved settings.\n");exit(1); }
    $value=$count===1?trim($matches[1][0][0]):(preg_match("/^[ \\t]*(WEB|TENANT)[ \\t]*:/im",$text)?"":trim($text));
    if ($value!=="") {
      // Older desktop configs used backslashes; normalize only for deciding
      // whether an endpoint is our own loopback origin, never remote values.
      $normalized=str_replace("\\","/",$value);
      $uri=parse_url($normalized);
      if (!is_array($uri) || strtolower((string)($uri["scheme"]??""))!=="http" || !in_array(strtolower((string)($uri["host"]??"")),["localhost","127.0.0.1","[::1]"],true) || !in_array($uri["port"]??80,[80,8080],true) || !in_array($uri["path"]??"",["","/"],true) || isset($uri["query"]) || isset($uri["fragment"]) || isset($uri["user"]) || isset($uri["pass"])) exit(0);
    }
    if ($count===1) {
      [$line,$offset]=$matches[0][0];$updated=substr($text,0,$offset)."LOCAL: ".$origin.substr($text,$offset+strlen($line));
    } elseif ($value!=="") { $updated="LOCAL: ".$origin."\nWEB: \nTENANT: \n"; }
    else { $updated="LOCAL: ".$origin."\n".$text; }
    if ($updated!==$text || !is_file($file)) {
      if (file_put_contents($file,$updated)===false) exit(1);
    }
  ' "$file" "$HTTP_PORT"
}
# END STANDALONE DESKTOP ENDPOINT

